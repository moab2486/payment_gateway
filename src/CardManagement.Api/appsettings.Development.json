{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "NIP": {
    "BaseUrl": "https://sandbox.nip.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_NIP_API_KEY",
    "TimeoutMs": 60000,
    "StatusInquiryDelayMs": 3000
  },
  "NQR": {
    "BaseUrl": "https://sandbox.nqr.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_NQR_API_KEY",
    "DynamicQrExpiryMinutes": 30
  },
  "EBillsPay": {
    "BaseUrl": "https://sandbox.ebillspay.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_EBILLSPAY_API_KEY",
    "BillerDirectoryCacheTtlMinutes": 5
  },
  "MCash": {
    "BaseUrl": "https://sandbox.mcash.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_MCASH_API_KEY",
    "SessionTimeoutMs": 300000
  },
  "DirectDebit": {
    "BaseUrl": "https://sandbox.directdebit.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_DIRECTDEBIT_API_KEY",
    "MaxRetries": 2,
    "RetryIntervalHours": 1
  },
  "GAPS": {
    "BaseUrl": "https://sandbox.gaps.nibss-plc.com.ng/api/v1",
    "ApiKey": "DEV_GAPS_API_KEY",
    "MaxBatchSize": 100,
    "StatusPollIntervalMs": 5000
  },
  "Interswitch": {
    "Host": "sandbox.interswitch.com",
    "Port": 4043,
    "TimeoutMs": 60000,
    "ReconnectDelayMs": 3000,
    "TlsEnabled": false,
    "TerminalId": "DEV_TERMINAL_ID",
    "MerchantId": "DEV_MERCHANT_ID"
  },
  "Cardify": {
    "Host": "sandbox.cardify.com",
    "Port": 4043,
    "TimeoutMs": 60000,
    "ReconnectDelayMs": 3000,
    "TlsEnabled": false,
    "TerminalId": "DEV_TERMINAL_ID",
    "MerchantId": "DEV_MERCHANT_ID"
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "OpenDurationSeconds": 30,
    "HalfOpenProbeCount": 2
  },
  "FraudRisk": {
    "BlockThreshold": 90,
    "ReviewThreshold": 60,
    "FallbackPolicy": "Approve",
    "MaxEvaluationTimeMs": 500
  },
  "Idempotency": {
    "CleanupIntervalMinutes": 10
  },
  "DurableProcessor": {
    "ConsumerGroup": "payment-processor-dev",
    "Topics": [ "payment-requests", "payment-events" ],
    "MaxRetries": 3,
    "InitialRetryDelayMs": 500,
    "DeadLetterTopicSuffix": ".dlq"
  },
  "PciSecurity": {
    "EncryptionKey": "DEV_ONLY_ENCRYPTION_KEY_32CHARS!",
    "AllowedServices": [ "PaymentOrchestrator", "InterswitchAdapter", "CardifyAdapter" ]
  },
  "Dispute": {
    "MaxDisputeWindowDays": 365,
    "KafkaTopic": "dispute-events",
    "ChannelTimeframeDays": {
      "NIP": 90,
      "NQR": 90,
      "EBillsPay": 90,
      "MCash": 90,
      "DirectDebit": 90,
      "GAPS": 90,
      "Interswitch": 365,
      "Cardify": 365
    }
  },
  "ReconciliationWorkerPool": {
    "Concurrency": 2,
    "Capacity": 100
  },
  "WebhookDelivery": {
    "Concurrency": 4,
    "Capacity": 500,
    "BaseDelayMs": 1000,
    "BackoffMultiplier": 2.0,
    "MaxRetries": 3,
    "HttpTimeoutSeconds": 60,
    "SuspensionThreshold": 5
  },
  "NotificationWorkerPool": {
    "Concurrency": 4,
    "Capacity": 200
  },
  "Notifications": {
    "Email": {
      "SmtpHost": "localhost",
      "SmtpPort": 1025,
      "UseTls": false,
      "Username": null,
      "Password": null,
      "FromAddress": "dev@cardmanagement.local",
      "FromName": "CardManagement Dev",
      "TimeoutSeconds": 60
    },
    "Sms": {
      "BaseUrl": "http://localhost:5050/sms",
      "ApiKey": "DEV_SMS_API_KEY",
      "SenderId": "CardMgmtDev",
      "TimeoutSeconds": 60
    },
    "WhatsApp": {
      "BaseUrl": "http://localhost:3000",
      "ApiKey": "",
      "Session": "default",
      "TimeoutSeconds": 60,
      "HealthCheckOnStartup": false
    }
  },
  "DeveloperPortal": {
    "ApiKeyCache": {
      "DefaultTtl": "00:01:00",
      "RedisConnectionString": "localhost:6379"
    },
    "ApiKeyValidation": {
      "CacheTtl": "00:01:00",
      "ExcludedPaths": [ "/health", "/swagger" ]
    },
    "RequestLogRetentionDays": 30,
    "MaxKeysPerDeveloper": 10,
    "MaxSubscriptionsPerMerchant": 50
  },
  "AdminConsole": {
    "CommandExpiryHours": 1,
    "ExpiryCheckIntervalMinutes": 1,
    "ReadModelStalenessThresholdSeconds": 60
  },
  "AdminReadModelKafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "admin-readmodel-projector-dev",
    "Topics": [
      "cardmgmt.events.payments",
      "platform.reconciliation.batch-completed",
      "cardmgmt.events.disputes",
      "cardmgmt.events.deliveries"
    ],
    "StalenessThreshold": "00:01:00"
  }
}
